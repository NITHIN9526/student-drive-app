# Turso (hosted SQLite) — create a free database at https://app.turso.tech
# then copy the connection URL and generate an auth token.
TURSO_DATABASE_URL=libsql://students_drive-<your-org>.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Vercel Blob (file uploads) — created automatically when you connect a Blob
# store to your project in the Vercel dashboard. Token looks like:
# vercel_blob_rw_...
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxx